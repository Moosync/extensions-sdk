{
  "compilerOptions": {
    "target": "ES2020",
    "outDir": "./lib",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "@extism/js-pdk"
    ], // while this makes the IDE aware of the ones that are
    "moduleResolution": "Node",
    "emitDeclarationOnly": false,
    "isolatedModules": false,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/index.ts"
  ]
}